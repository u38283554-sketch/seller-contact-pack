# ZapUPI Merchant Key (from ZapUPI Developers dashboard)
ZAP_KEY=""

# Velona OpenAI-compatible API Gateway Key
AI_API_KEY=""

# AI Gateway Base URL (default: https://velona.in/v1)
AI_BASE_URL="https://velona.in/v1"

# AI Model Name (default: deepseek/deepseek-v4-flash)
AI_MODEL="deepseek/deepseek-v4-flash"

# Cryptographic token secret used to hash IP + device id for free tier tracking
TOKEN_SECRET=""

# Your published Netlify or custom domain URL (e.g. https://your-site.netlify.app)
SITE_URL=""

# Set to true only if testing ZapUPI test transactions, otherwise keep false for production
ALLOW_TEST_PAYMENTS="false"
